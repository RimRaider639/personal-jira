{
  "expo": {
    "name": "Personal Kanban Board",
    "slug": "personal-kanban-board",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kanban.personal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1"
      },
      "package": "com.kanban.personal"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "kanban"
  }
}
